PROTOCOL native VERSION 1,
NAMED TYPE Identifier (Integer),
CHOICE Selection { `none, `selected (item: Text) },
RECORD Packet {
  text: Text,
  bytes: Bytes,
  integer: Integer,
  number: Float,
  flag: Boolean,
  items: LIST Integer,
  dict: MAP Text,
  identifier: Identifier,
  selection: Selection,
},
METHOD echo (packet: Packet) RETURNS (packet: Packet) ERRORS [`bad (reason: Text)],
