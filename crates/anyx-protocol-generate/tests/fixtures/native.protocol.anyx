PROTOCOL native VERSION 1,
NAMED TYPE Identifier (value ⁽Integer),
TYPE ALIAS Selection [| `none, `selected (item ⁽Text) |],
TYPE ALIAS Packet ⁽{
  text (text ⁽Text),
  bytes (bytes ⁽Bytes),
  integer (integer ⁽Integer),
  number (number ⁽Float),
  flag (flag ⁽Boolean),
  items (items ⁽LIST Integer),
  dict (dict ⁽MAP Text),
  identifier (identifier ⁽Identifier),
  selection (selection ⁽Selection),
},
METHOD echo (packet ⁽Packet) RETURNS (packet ⁽Packet) ERRORS [| `bad (reason ⁽Text) |],
