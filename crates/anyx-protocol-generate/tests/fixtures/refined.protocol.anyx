PROTOCOL refined VERSION 1,
TYPE ALIAS Revision: Integer . WHERE [1 <= _],
TYPE ALIAS Limit: Integer . WHERE [10 <= _ < 30],
NAMED TYPE Probability (value: Float . WHERE [0 <= _ <= 1]),
NAMED TYPE Score Path (value: Text . WHERE [_ ends with ".poentaro"]),
NAMED TYPE Short Text (value: Text . WHERE [1 <= (_ length) <= 3]),
NAMED TYPE Large (value: Integer . WHERE [9007199254740992 < _]),
NAMED TYPE Linear (value: Integer . WHERE [0 < (_ * 2), (_ + 1) <= 30]),
NAMED TYPE Wide (value: Integer . WHERE [0 < ((_ * 9223372036854775807) * 9223372036854775807)]),
NAMED TYPE Contains Zero (value: Text . WHERE [_ contains "\u00001"]),
NAMED TYPE Outside Range (value: Integer . WHERE [not: 1 <= _ <= 3]),
NAMED TYPE True Only (value: Boolean . WHERE [_ and (`true)]),
NAMED TYPE Names (value: (LIST Text) WHERE [1 <= (_ length) <= 3]),
TYPE ALIAS Summary: { path (path: Score Path), revision (revision: Revision), limit (limit: Limit) DEFAULT limit 10 },
TYPE ALIAS Box of (Item: TYPE): { value (value: Item) },
METHOD write (path: Score Path) at (revision: Revision)
    REQUIRES [revision < 10]
    RETURNS (saved revision: Revision)
    ENSURES [saved revision = revision]
    ERRORS [| |],
METHOD limit (value: Integer . WHERE [10 <= _ < 30]) RETURNS (value: Integer . WHERE [10 <= _ < 30]) ERRORS [| |],
METHOD summary (value: Summary) RETURNS (value: Summary) ERRORS [| |],
METHOD boxed (value: Box of (Integer . WHERE [10 <= _ < 30])) RETURNS (value: Box of (Limit)) ERRORS [| |],
METHOD score (value: Probability) RETURNS (value: Probability) ERRORS [| |],
METHOD names (value: Names) RETURNS (value: Names) ERRORS [| |],
