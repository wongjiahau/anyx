## Every kind of type, for the tests of the generated code.
PROTOCOL types VERSION 1,

# When to remind the owner.
RECORD Reminder {
    note: Text,
    at: Instant,
    every (Duration?) DEFAULT every (`null),
    # How many times to remind before giving up.
    times (Integer) DEFAULT times 3,
    # When each person last saw it, by their name.
    seen (MAP: Instant) DEFAULT seen {},
    # The hours of the day it stays quiet, from and to.
    quiet from (Integer) to (Integer) DEFAULT quiet from 22 to 7,
},

CHOICE Schedule { `never, `once at (at: Instant), `every (period: Duration) },

METHOD remind (reminder: Reminder) RETURNS (schedule: Schedule),

METHOD count (reminders: MAP: Reminder) RETURNS (times: MAP Integer),

METHOD snooze (reminder: Reminder) for (duration: Duration)
    RETURNS (reminders: LIST: Reminder)
    ERRORS [
        # Snoozed past its next time.
        `overdue since (since: Instant),
    ],
