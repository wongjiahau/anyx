# Finds files by name, as `fd` does, skipping what `.gitignore`, `.ignore`
# and `.fdignore` ignore, and hidden files. The pattern is a regex matched
# against each file's name, in smart case: any case, unless the pattern has
# an uppercase letter. Paths are relative to the shell's working directory,
# in the order of the walk: by name, each directory before what it holds.
# Directories are found too.
PROTOCOL fd VERSION 1,

# A depth below a search path: its entries are at depth 1.
TYPE ALIAS Depth: Integer . WHERE [0 <= _],

# A count of bytes.
TYPE ALIAS Size: Integer . WHERE [0 <= _],

# A count of results, at least one.
TYPE ALIAS Count: Integer . WHERE [1 <= _],

# What a file is, for `only _`.
TYPE ALIAS Kind [|
    `file,
    `directory,
    `symlink,
    # A file the owner, group or others may run.
    `executable,
    # An empty file, or a directory with nothing in it.
    `empty,
    `socket,
    `pipe,
    `block device,
    `char device,
|],

# The case a pattern is matched in.
TYPE ALIAS Case [|
    # Any case, unless the pattern has an uppercase letter.
    `smart case,
    `any case,
    `exact case,
|],

# How a pattern is read.
TYPE ALIAS Syntax [|
    `regex pattern,
    # A glob, such as `*.rs`.
    `glob pattern,
    # Plain text.
    `fixed text pattern,
|],

# How `find` searches, as in `` { `glob pattern, `hidden, max depth 2 } ``.
# Each field left out keeps fd's default, and a file must pass every
# filter given.
TYPE ALIAS Search: {
    `(case: Case) DEFAULT `smart case,
    `(pattern: Syntax) DEFAULT `regex pattern,
    # Match the pattern against the whole path, not just the name.
    `(full path: [| `full path, `null |]) DEFAULT `null,
    # Each file must match these patterns too, in the same syntax and case.
    also matching (LIST Text) DEFAULT also matching [],
    # Find hidden files and directories too.
    `(hidden: [| `hidden, `null |]) DEFAULT `null,
    # Don't skip what ignore files ignore.
    `(no ignore: [| `no ignore, `null |]) DEFAULT `null,
    # Don't skip what `.gitignore` ignores, but still what `.ignore` and
    # `.fdignore` ignore.
    `(no ignore vcs: [| `no ignore vcs, `null |]) DEFAULT `null,
    # Don't read ignore files in directories above the search path.
    `(no ignore parent: [| `no ignore parent, `null |]) DEFAULT `null,
    # Read `.gitignore` outside a git repository too.
    `(no require git: [| `no require git, `null |]) DEFAULT `null,
    # Skip what these files ignore, each written as `.gitignore` is.
    ignore files (LIST Text) DEFAULT ignore files [],
    # Skip paths these globs match, as `--exclude` does.
    excluding (LIST Text) DEFAULT excluding [],
    # Follow symbolic links into the directories they point to.
    `(follow links: [| `follow links, `null |]) DEFAULT `null,
    # Don't go into another file system.
    `(one file system: [| `one file system, `null |]) DEFAULT `null,
    # Don't go into a directory that matched.
    `(prune: [| `prune, `null |]) DEFAULT `null,
    max depth (Depth?) DEFAULT max depth (`null),
    min depth (Depth?) DEFAULT min depth (`null),
    # Find only these kinds of file, or every kind when empty.
    only (LIST Kind) DEFAULT only [],
    # Find only files with one of these extensions, such as `"rs"`, or
    # with any when empty.
    extensions (LIST Text) DEFAULT extensions [],
    at least (Size?) bytes DEFAULT at least (`null) bytes,
    at most (Size?) bytes DEFAULT at most (`null) bytes,
    changed within (Duration?) DEFAULT changed within (`null),
    changed since (Instant?) DEFAULT changed since (`null),
    changed before (Instant?) DEFAULT changed before (`null),
    changed more than (Duration?) ago DEFAULT changed more than (`null) ago,
    # Owned by the user with this id.
    owned by user (Integer?) DEFAULT owned by user (`null),
    # Owned by the group with this id.
    owned by group (Integer?) DEFAULT owned by group (`null),
    # Stop after this many paths.
    at most (Count?) results DEFAULT at most (`null) results,
},

# What a found file is, as `fd --list-details` shows it.
TYPE ALIAS Details: {
    path: Text,
    kind: Kind,
    size: Size,
    modified: Instant,
},

TYPE ALIAS Fd Errors [|
    `(path: Text) does not exist,
    `invalid pattern (message: Text),
    `invalid glob (message: Text),
    # A path fd found can't be written as Unicode text.
    `(path: Text) is not unicode,
|],

# Searches the paths, or the working directory when there are none, and
# as fd does by default when the search says nothing: `find "x"` is
# `find "x" in [] with {}`.
READ ONLY METHOD find (pattern: Text)
    [in (paths: LIST Text) DEFAULT in []]
    [with (search: Search) DEFAULT with {}]
    RETURNS (paths: LIST Text)
    ERRORS [| Fd Errors |]
    EXAMPLES [
        find "\\.rs$" in ["src"] with { only [`file] } RETURNS ["src/lib.rs", "src/main.rs"],
        find "(" in ["src"] with { `hidden } ERROR `invalid pattern "unclosed group",
        find "^README" RETURNS ["README.md"],
    ],

# What `find` finds, with each file's details.
READ ONLY METHOD details of (pattern: Text)
    [in (paths: LIST Text) DEFAULT in []]
    [with (search: Search) DEFAULT with {}]
    RETURNS (files: LIST Details)
    ERRORS [| Fd Errors |],

# Whether `find` finds anything. It stops at the first.
READ ONLY METHOD any match of (pattern: Text)
    [in (paths: LIST Text) DEFAULT in []]
    [with (search: Search) DEFAULT with {}]
    RETURNS (found: Boolean)
    ERRORS [| Fd Errors |],
