# Finds files by name, as `fd` does, skipping what `.gitignore`, `.ignore`
# and `.fdignore` ignore, and hidden files. The pattern is a regex matched
# against each file's name, in smart case: any case, unless the pattern has
# an uppercase letter. Paths are relative to the shell's working directory,
# in the order of the walk: by name, each directory before what it holds.
# Directories are found too.
PROTOCOL fd VERSION 1,

# A depth below a search path: its entries are at depth 1.
TYPE Depth: Integer . WHERE [0 <= _],

# A count of bytes.
TYPE Size: Integer . WHERE [0 <= _],

# A count of results, at least one.
TYPE Count: Integer . WHERE [1 <= _],

# What a file is, for `only _`.
CHOICE Kind {
    file,
    directory,
    symlink,
    # A file the owner, group or others may run.
    executable,
    # An empty file, or a directory with nothing in it.
    empty,
    socket,
    pipe,
    block device,
    char device,
},

# The case a pattern is matched in.
CHOICE Case {
    # Any case, unless the pattern has an uppercase letter.
    smart,
    any,
    exact,
},

# How a pattern is read.
CHOICE Syntax {
    regex,
    # A glob, such as `*.rs`.
    glob,
    # Plain text.
    fixed text,
},

# How `find` searches, as in `{ (glob) pattern, hidden, max depth 2 }`.
# Each field left out keeps fd's default, and a file must pass every
# filter given.
RECORD Search {
    (Case DEFAULT smart) case,
    (Syntax DEFAULT regex) pattern,
    # Match the pattern against the whole path, not just the name.
    full path,
    # Each file must match these patterns too, in the same syntax and case.
    also matching: LIST Text DEFAULT [],
    # Find hidden files and directories too.
    hidden,
    # Don't skip what ignore files ignore.
    no ignore,
    # Don't skip what `.gitignore` ignores, but still what `.ignore` and
    # `.fdignore` ignore.
    no ignore vcs,
    # Don't read ignore files in directories above the search path.
    no ignore parent,
    # Read `.gitignore` outside a git repository too.
    no require git,
    # Skip what these files ignore, each written as `.gitignore` is.
    ignore files: LIST Text DEFAULT [],
    # Skip paths these globs match, as `--exclude` does.
    excluding: LIST Text DEFAULT [],
    # Follow symbolic links into the directories they point to.
    follow links,
    # Don't go into another file system.
    one file system,
    # Don't go into a directory that matched.
    prune,
    max depth: Depth? DEFAULT null,
    min depth: Depth? DEFAULT null,
    # Find only these kinds of file, or every kind when empty.
    only: LIST Kind DEFAULT [],
    # Find only files with one of these extensions, such as `"rs"`, or
    # with any when empty.
    extensions: LIST Text DEFAULT [],
    at least (Size? DEFAULT null) bytes,
    at most (Size? DEFAULT null) bytes,
    changed within: Duration? DEFAULT null,
    changed since: Instant? DEFAULT null,
    changed before: Instant? DEFAULT null,
    changed more than (Duration? DEFAULT null) ago,
    # Owned by the user with this id.
    owned by user: Integer? DEFAULT null,
    # Owned by the group with this id.
    owned by group: Integer? DEFAULT null,
    # Stop after this many paths.
    at most (Count? DEFAULT null) results,
},

# What a found file is, as `fd --list-details` shows it.
RECORD Details {
    path: Text,
    kind: Kind,
    size: Size,
    modified: Instant,
},

ERRORS fd errors [
    (path: Text) does not exist,
    invalid pattern (message: Text),
    invalid glob (message: Text),
    # A path fd found can't be written as Unicode text.
    (path: Text) is not unicode,
],

READ ONLY METHOD find (pattern: Text) in (paths: LIST Text) with (search: Search)
    RETURNS (paths: LIST Text)
    ERRORS fd errors
    EXAMPLES [
        find "\\.rs$" in ["src"] with { only [file] } RETURNS ["src/lib.rs", "src/main.rs"],
        find "(" in ["src"] with { hidden } ERROR invalid pattern "unclosed group",
    ],

# In the working directory.
READ ONLY METHOD find (pattern: Text) with (search: Search)
    RETURNS (paths: LIST Text)
    ERRORS fd errors,

# As fd searches by default.
READ ONLY METHOD find (pattern: Text) in (paths: LIST Text)
    RETURNS (paths: LIST Text)
    ERRORS fd errors,

# In the working directory, as fd searches by default.
READ ONLY METHOD find (pattern: Text)
    RETURNS (paths: LIST Text)
    ERRORS fd errors,

# What `find` finds, with each file's details.
READ ONLY METHOD details of (pattern: Text) in (paths: LIST Text) with (search: Search)
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# What `find` finds, with each file's details. In the working directory.
READ ONLY METHOD details of (pattern: Text) with (search: Search)
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# What `find` finds, with each file's details. As fd searches by default.
READ ONLY METHOD details of (pattern: Text) in (paths: LIST Text)
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# What `find` finds, with each file's details. In the working directory, as
# fd searches by default.
READ ONLY METHOD details of (pattern: Text)
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first.
READ ONLY METHOD any match of (pattern: Text) in (paths: LIST Text) with (search: Search)
    RETURNS (found: Boolean)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first. In the working
# directory.
READ ONLY METHOD any match of (pattern: Text) with (search: Search)
    RETURNS (found: Boolean)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first. As fd searches by
# default.
READ ONLY METHOD any match of (pattern: Text) in (paths: LIST Text)
    RETURNS (found: Boolean)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first. In the working
# directory, as fd searches by default.
READ ONLY METHOD any match of (pattern: Text)
    RETURNS (found: Boolean)
    ERRORS fd errors,
