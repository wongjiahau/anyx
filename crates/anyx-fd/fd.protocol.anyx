# Finds files by name, as `fd` does, skipping what `.gitignore`, `.ignore`
# and `.fdignore` ignore, and hidden files. The pattern is a regex matched
# against each file's name, in smart case: any case, unless the pattern has
# an uppercase letter. Paths are relative to the shell's working directory,
# in the order of the walk: by name, each directory before what it holds.
# Directories are found too.
PROTOCOL fd VERSION 1,

# A depth below a search path: its entries are at depth 1.
TYPE Depth: Integer . WHERE [0 <= _],

# A count of bytes.
TYPE Size: Integer . WHERE [0 <= _],

# What a file is, for `_ only`.
CHOICE Kind {
    file,
    directory,
    symlink,
    # A file the owner, group or others may run.
    executable,
    # An empty file, or a directory with nothing in it.
    empty,
    socket,
    pipe,
    block device,
    char device,
},

# A change to how `find` searches. A setting may come once, except
# `_ only`, `extension _` and `excluding _`, which find what any of them
# allow, and `also matching _`, which each must match.
CHOICE Setting {
    # Match the pattern in exactly its case.
    exact case,
    # Match the pattern in any case.
    any case,
    # The pattern is a glob, such as `*.rs`, not a regex.
    glob,
    # The pattern is plain text, not a regex.
    fixed text,
    # Match the pattern against the whole path, not just the name.
    full path,
    # Each file must match this pattern too, in the same syntax and case.
    also matching (pattern: Text),
    # Find hidden files and directories too.
    hidden,
    # Don't skip what ignore files ignore.
    no ignore,
    # Don't skip what `.gitignore` ignores, but still what `.ignore` and
    # `.fdignore` ignore.
    no ignore vcs,
    # Don't read ignore files in directories above the search path.
    no ignore parent,
    # Read `.gitignore` outside a git repository too.
    no require git,
    # Skip what this file ignores, written as `.gitignore` is.
    ignore file (path: Text),
    # Skip paths this glob matches, as `--exclude` does.
    excluding (glob: Text),
    # Follow symbolic links into the directories they point to.
    follow links,
    # Don't go into another file system.
    one file system,
    # Don't go into a directory that matched.
    prune,
    max depth (depth: Depth),
    min depth (depth: Depth),
    exact depth (depth: Depth),
    # Find only these: say `(file) only` and `(directory) only` for both.
    (what: Kind) only,
    # Find only files with this extension, such as `"rs"`.
    extension (extension: Text),
    at least (size: Size) bytes,
    at most (size: Size) bytes,
    changed within (period: Duration),
    changed since (time: Instant),
    changed before (time: Instant),
    changed more than (period: Duration) ago,
    # Owned by the user with this id.
    owned by user (id: Integer),
    # Owned by the group with this id.
    owned by group (id: Integer),
    # Stop after this many paths.
    at most (count: Integer . WHERE [1 <= _]) results,
},

# What a found file is, as `fd --list-details` shows it.
RECORD Details {
    path: Text,
    kind: Kind,
    size: Size,
    modified: Instant,
},

ERRORS fd errors [
    (path: Text) does not exist,
    invalid pattern (message: Text),
    invalid glob (message: Text),
    # A path fd found can't be written as Unicode text.
    (path: Text) is not unicode,
],

READ ONLY METHOD find (pattern: Text) in (paths: LIST Text) with (settings: LIST Setting)
    REQUIRES [
        settings . has no repeats,
        settings . has at most one of [exact case, any case],
        settings . has at most one of [glob, fixed text],
        settings . has at most one of [no ignore, no ignore vcs],
        settings . has at most one of [max depth _, exact depth _],
        settings . has at most one of [min depth _, exact depth _],
        settings . has at most one of [at least _ bytes],
        settings . has at most one of [at most _ bytes],
        settings . has at most one of [changed within _, changed since _],
        settings . has at most one of [changed before _, changed more than _ ago],
        settings . has at most one of [owned by user _],
        settings . has at most one of [owned by group _],
        settings . has at most one of [at most _ results],
    ]
    RETURNS (paths: LIST Text)
    ERRORS fd errors
    EXAMPLES [
        find "\\.rs$" in ["src"] with [(file) only] RETURNS ["src/lib.rs", "src/main.rs"],
        find "(" in ["src"] with [hidden] ERROR invalid pattern "unclosed group",
    ],

# In the working directory.
READ ONLY METHOD find (pattern: Text) with (settings: LIST Setting)
    REQUIRES [
        settings . has no repeats,
        settings . has at most one of [exact case, any case],
        settings . has at most one of [glob, fixed text],
        settings . has at most one of [no ignore, no ignore vcs],
        settings . has at most one of [max depth _, exact depth _],
        settings . has at most one of [min depth _, exact depth _],
        settings . has at most one of [at least _ bytes],
        settings . has at most one of [at most _ bytes],
        settings . has at most one of [changed within _, changed since _],
        settings . has at most one of [changed before _, changed more than _ ago],
        settings . has at most one of [owned by user _],
        settings . has at most one of [owned by group _],
        settings . has at most one of [at most _ results],
    ]
    RETURNS (paths: LIST Text)
    ERRORS fd errors,

# With no settings.
READ ONLY METHOD find (pattern: Text) in (paths: LIST Text)
    RETURNS (paths: LIST Text)
    ERRORS fd errors,

# In the working directory, with no settings.
READ ONLY METHOD find (pattern: Text)
    RETURNS (paths: LIST Text)
    ERRORS fd errors,

# What `find` finds, with each file's details.
READ ONLY METHOD details of (pattern: Text) in (paths: LIST Text) with (settings: LIST Setting)
    REQUIRES [
        settings . has no repeats,
        settings . has at most one of [exact case, any case],
        settings . has at most one of [glob, fixed text],
        settings . has at most one of [no ignore, no ignore vcs],
        settings . has at most one of [max depth _, exact depth _],
        settings . has at most one of [min depth _, exact depth _],
        settings . has at most one of [at least _ bytes],
        settings . has at most one of [at most _ bytes],
        settings . has at most one of [changed within _, changed since _],
        settings . has at most one of [changed before _, changed more than _ ago],
        settings . has at most one of [owned by user _],
        settings . has at most one of [owned by group _],
        settings . has at most one of [at most _ results],
    ]
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# What `find` finds, with each file's details. In the working directory.
READ ONLY METHOD details of (pattern: Text) with (settings: LIST Setting)
    REQUIRES [
        settings . has no repeats,
        settings . has at most one of [exact case, any case],
        settings . has at most one of [glob, fixed text],
        settings . has at most one of [no ignore, no ignore vcs],
        settings . has at most one of [max depth _, exact depth _],
        settings . has at most one of [min depth _, exact depth _],
        settings . has at most one of [at least _ bytes],
        settings . has at most one of [at most _ bytes],
        settings . has at most one of [changed within _, changed since _],
        settings . has at most one of [changed before _, changed more than _ ago],
        settings . has at most one of [owned by user _],
        settings . has at most one of [owned by group _],
        settings . has at most one of [at most _ results],
    ]
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# What `find` finds, with each file's details. With no settings.
READ ONLY METHOD details of (pattern: Text) in (paths: LIST Text)
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# What `find` finds, with each file's details. In the working directory, with no settings.
READ ONLY METHOD details of (pattern: Text)
    RETURNS (files: LIST Details)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first.
READ ONLY METHOD any match of (pattern: Text) in (paths: LIST Text) with (settings: LIST Setting)
    REQUIRES [
        settings . has no repeats,
        settings . has at most one of [exact case, any case],
        settings . has at most one of [glob, fixed text],
        settings . has at most one of [no ignore, no ignore vcs],
        settings . has at most one of [max depth _, exact depth _],
        settings . has at most one of [min depth _, exact depth _],
        settings . has at most one of [at least _ bytes],
        settings . has at most one of [at most _ bytes],
        settings . has at most one of [changed within _, changed since _],
        settings . has at most one of [changed before _, changed more than _ ago],
        settings . has at most one of [owned by user _],
        settings . has at most one of [owned by group _],
        settings . has at most one of [at most _ results],
    ]
    RETURNS (found: Boolean)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first. In the working directory.
READ ONLY METHOD any match of (pattern: Text) with (settings: LIST Setting)
    REQUIRES [
        settings . has no repeats,
        settings . has at most one of [exact case, any case],
        settings . has at most one of [glob, fixed text],
        settings . has at most one of [no ignore, no ignore vcs],
        settings . has at most one of [max depth _, exact depth _],
        settings . has at most one of [min depth _, exact depth _],
        settings . has at most one of [at least _ bytes],
        settings . has at most one of [at most _ bytes],
        settings . has at most one of [changed within _, changed since _],
        settings . has at most one of [changed before _, changed more than _ ago],
        settings . has at most one of [owned by user _],
        settings . has at most one of [owned by group _],
        settings . has at most one of [at most _ results],
    ]
    RETURNS (found: Boolean)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first. With no settings.
READ ONLY METHOD any match of (pattern: Text) in (paths: LIST Text)
    RETURNS (found: Boolean)
    ERRORS fd errors,

# Whether `find` finds anything. It stops at the first. In the working directory, with no settings.
READ ONLY METHOD any match of (pattern: Text)
    RETURNS (found: Boolean)
    ERRORS fd errors,
