## Finds files by name, as `fd` does, skipping what `.gitignore`, `.ignore`
## and `.fdignore` ignore, and hidden files. The pattern is a regex matched
## against each file's name, in smart case: any case, unless the pattern has
## an uppercase letter. Paths are relative to the shell's working directory,
## in the order of the walk: by name, each directory before what it holds.
## Directories are found too.

DATA Boolean RETURNS Type WITH [true RETURNS Boolean, false RETURNS Boolean],

## A time, as seconds since 1970-01-01 UTC.
DATA Moment RETURNS Type WITH [
  (seconds: Integer) seconds since the epoch RETURNS Moment,
],

## A span of time, for `changed within (2 hours)`.
DATA Age RETURNS Type WITH [
  (count: Natural) seconds RETURNS Age,
  (count: Natural) minutes RETURNS Age,
  (count: Natural) hours RETURNS Age,
  (count: Natural) days RETURNS Age,
  (count: Natural) weeks RETURNS Age,
],

## What a file is, for `only [file, directory]`.
DATA File kind RETURNS Type WITH [
  file RETURNS File kind,
  directory RETURNS File kind,
  symlink RETURNS File kind,
  ## A file the owner, group or others may run.
  executable RETURNS File kind,
  ## An empty file, or a directory with nothing in it.
  empty RETURNS File kind,
  socket RETURNS File kind,
  pipe RETURNS File kind,
  block device RETURNS File kind,
  char device RETURNS File kind,
],

## ---------------------------------------------------------------------------
## The choices a search makes. Each is a field written as its value alone,
## as in `{ glob pattern, hidden, max depth 2 }`, and left out it keeps
## fd's default, its first constructor.

## The case a pattern is matched in.
DATA Case RETURNS Type WITH [
  ## Any case, unless the pattern has an uppercase letter.
  smart case RETURNS Case,
  any case RETURNS Case,
  exact case RETURNS Case,
],

## How a pattern is read.
DATA Syntax RETURNS Type WITH [
  regex pattern RETURNS Syntax,
  ## A glob, such as `*.rs`.
  glob pattern RETURNS Syntax,
  ## Plain text.
  fixed text pattern RETURNS Syntax,
],

## What the pattern is matched against.
DATA Subject RETURNS Type WITH [
  file name RETURNS Subject,
  full path RETURNS Subject,
],

DATA Hidden files RETURNS Type WITH [
  skip hidden RETURNS Hidden files,
  ## Find hidden files and directories too.
  hidden RETURNS Hidden files,
],

DATA Ignore files RETURNS Type WITH [
  respect ignore files RETURNS Ignore files,
  ## Don't skip what ignore files ignore.
  no ignore RETURNS Ignore files,
],

DATA Version control ignores RETURNS Type WITH [
  respect vcs ignores RETURNS Version control ignores,
  ## Don't skip what `.gitignore` ignores, but still what `.ignore` and
  ## `.fdignore` ignore.
  no ignore vcs RETURNS Version control ignores,
],

DATA Parent ignores RETURNS Type WITH [
  respect parent ignores RETURNS Parent ignores,
  ## Don't read ignore files in directories above the search path.
  no ignore parent RETURNS Parent ignores,
],

DATA Git repository RETURNS Type WITH [
  require git RETURNS Git repository,
  ## Read `.gitignore` outside a git repository too.
  no require git RETURNS Git repository,
],

DATA Links RETURNS Type WITH [
  stay out of links RETURNS Links,
  ## Follow symbolic links into the directories they point to.
  follow links RETURNS Links,
],

DATA File systems RETURNS Type WITH [
  cross file systems RETURNS File systems,
  ## Don't go into another file system.
  one file system RETURNS File systems,
],

DATA Matched directories RETURNS Type WITH [
  enter matches RETURNS Matched directories,
  ## Don't go into a directory that matched.
  prune RETURNS Matched directories,
],

## A depth below a search path: its entries are at depth 1.
DATA Most depth RETURNS Type WITH [
  any depth RETURNS Most depth,
  max depth (depth: Natural) RETURNS Most depth,
],

DATA Least depth RETURNS Type WITH [
  from the top RETURNS Least depth,
  min depth (depth: Natural) RETURNS Least depth,
],

DATA Least size RETURNS Type WITH [
  no minimum size RETURNS Least size,
  at least (size: Natural) bytes RETURNS Least size,
],

DATA Most size RETURNS Type WITH [
  no maximum size RETURNS Most size,
  at most (size: Natural) bytes RETURNS Most size,
],

DATA Recency RETURNS Type WITH [
  changed any time RETURNS Recency,
  changed within (age: Age) RETURNS Recency,
],

DATA Start RETURNS Type WITH [
  since the beginning RETURNS Start,
  changed since (time: Moment) RETURNS Start,
],

DATA End RETURNS Type WITH [
  until now RETURNS End,
  changed before (time: Moment) RETURNS End,
],

DATA Oldness RETURNS Type WITH [
  any age RETURNS Oldness,
  changed more than (age: Age) ago RETURNS Oldness,
],

DATA User RETURNS Type WITH [
  any user RETURNS User,
  ## Owned by the user with this id.
  owned by user (id: Integer) RETURNS User,
],

DATA Group RETURNS Type WITH [
  any group RETURNS Group,
  ## Owned by the group with this id.
  owned by group (id: Integer) RETURNS Group,
],

DATA Limit RETURNS Type WITH [
  all results RETURNS Limit,
  ## Stop after this many paths.
  at most (count: Natural) results RETURNS Limit,
],

## How fd searches, as in `{ glob pattern, hidden, max depth 2 }`. Each
## field left out keeps fd's default, and a file must pass every filter
## given.
RECORD Search RETURNS Type WITH [
  (case: Case) DEFAULT smart case,
  (syntax: Syntax) DEFAULT regex pattern,
  (subject: Subject) DEFAULT file name,
  ## Each file must match these patterns too, in the same syntax and case.
  also matching (patterns: List of (Text)) DEFAULT also matching [],
  (hidden: Hidden files) DEFAULT skip hidden,
  (ignore: Ignore files) DEFAULT respect ignore files,
  (vcs: Version control ignores) DEFAULT respect vcs ignores,
  (parents: Parent ignores) DEFAULT respect parent ignores,
  (git: Git repository) DEFAULT require git,
  ## Skip what these files ignore, each written as `.gitignore` is.
  ignore files (files: List of (Text)) DEFAULT ignore files [],
  ## Skip paths these globs match, as `--exclude` does.
  excluding (globs: List of (Text)) DEFAULT excluding [],
  (links: Links) DEFAULT stay out of links,
  (file systems: File systems) DEFAULT cross file systems,
  (pruning: Matched directories) DEFAULT enter matches,
  (max depth: Most depth) DEFAULT any depth,
  (min depth: Least depth) DEFAULT from the top,
  ## Find only these kinds of file, or every kind when empty.
  only (kinds: List of (File kind)) DEFAULT only [],
  ## Find only files with one of these extensions, such as `"rs"`, or with
  ## any when empty.
  extensions (extensions: List of (Text)) DEFAULT extensions [],
  (least size: Least size) DEFAULT no minimum size,
  (most size: Most size) DEFAULT no maximum size,
  (recency: Recency) DEFAULT changed any time,
  (start: Start) DEFAULT since the beginning,
  (end: End) DEFAULT until now,
  (oldness: Oldness) DEFAULT any age,
  (user: User) DEFAULT any user,
  (group: Group) DEFAULT any group,
  (limit: Limit) DEFAULT all results,
],

## What a found file is, as `fd --list-details` shows it.
RECORD Details RETURNS Type WITH [
  path (path: Text),
  (kind: File kind),
  size (size: Natural) bytes,
  modified at (modified: Moment),
],

DATA Fd error RETURNS Type WITH [
  (path: Text) does not exist RETURNS Fd error,
  invalid pattern (message: Text) RETURNS Fd error,
  invalid glob (message: Text) RETURNS Fd error,
  ## A path fd found can't be written as Unicode text.
  (path: Text) is not unicode RETURNS Fd error,
],

DATA Outcome of (value: Type) RETURNS Type WITH [
  answered (value: Type) with (result: value) RETURNS Outcome of (value),
  failed (value: Type) with (error: Fd error) RETURNS Outcome of (value),
],

## ---------------------------------------------------------------------------
## What a caller asks. Each searches the paths, or the working directory
## when there are none, as fd does by default when the search says nothing:
## `find "x"` is `find "x" in [] with {}`.

DATA Request returning (response: Type) RETURNS Type WITH [
  find (pattern: Text)
      [in (paths: List of (Text)) DEFAULT in []]
      [with (search: Search) DEFAULT with {}]
    RETURNS Request returning (List of (Text)),
  ## What `find` finds, with each file's details.
  details of (pattern: Text)
      [in (paths: List of (Text)) DEFAULT in []]
      [with (search: Search) DEFAULT with {}]
    RETURNS Request returning (List of (Details)),
  ## Whether `find` finds anything. It stops at the first.
  any match of (pattern: Text)
      [in (paths: List of (Text)) DEFAULT in []]
      [with (search: Search) DEFAULT with {}]
    RETURNS Request returning (Boolean),
],

## What fd serves.
FUNCTION paths matching (pattern: Text) under (paths: List of (Text)) by (search: Search)
  RETURNS Outcome of (List of (Text)),
FUNCTION details matching (pattern: Text) under (paths: List of (Text)) by (search: Search)
  RETURNS Outcome of (List of (Details)),
FUNCTION whether any matches (pattern: Text) under (paths: List of (Text)) by (search: Search)
  RETURNS Outcome of (Boolean),

## The entry point: the answer to a request.
FUNCTION answer (response: Type) to (request: Request returning (response))
  RETURNS Outcome of (response)
  IS (MATCH request WITH [
    WHEN find (pattern) in (paths) with (search)
      THEN paths matching (pattern) under (paths) by (search),
    WHEN details of (pattern) in (paths) with (search)
      THEN details matching (pattern) under (paths) by (search),
    WHEN any match of (pattern) in (paths) with (search)
      THEN whether any matches (pattern) under (paths) by (search),
  ]),
