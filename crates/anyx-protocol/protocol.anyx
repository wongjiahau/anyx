## The schema language of the anyx protocol, in the grammar language.
## `src/grammar.rs` is generated from it; `tests/schema.rs` checks that it is
## up to date.

## A schema of one file has the `PROTOCOL` header first. A schema of a
## folder has it alone in `protocol.anyx`; every other file is a scope, and
## holds only definitions.
ENTRY [header: OPTIONAL: protocol, ZERO OR MORE: definition],

protocol: ANYFIX CALL [
  doc: OPTIONAL: STRING,
  WORD "PROTOCOL", name: type name,
  WORD "VERSION", version: NUMBER [INTEGER, AT LEAST 1, AT MOST 4294967295],
],

definition: ONE OF [record, choice, named type, errors, method],

record: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "RECORD", body: record body],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "RECORD", body: record body],
  public generic: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "PUBLIC", WORD "GENERIC", parameters: type parameters,
    WORD "RECORD", body: record body,
  ],
  generic: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "GENERIC", parameters: type parameters,
    WORD "RECORD", body: record body,
  ],
],

## A generic `RECORD` or `CHOICE` names its type parameters after `GENERIC`:
## `GENERIC (item) RECORD page { items: LIST: item }`. Parentheses around one
## name only group, so `(item)` is the name itself, and `(value, problem)`
## holds several.
type parameters: ONE OF [
  several: PARENTHESIS [ONE OR MORE: type parameter],
  one: type parameter,
],

type parameter: ANYFIX CALL [name: WORDS [NO KEYWORD]],

record body: ANYFIX CALL [name: WORDS [NO KEYWORD], fields: CURLY BRACE [ZERO OR MORE: field]],

field: ANYFIX CALL [doc: OPTIONAL: STRING, name: WORDS [NO KEYWORD], type: field type],

field type: ONE OF [
  optional: ANYFIX CALL [WORD "OPTIONAL", type: optional type],
  ## `DEFAULT` on a field that isn't `OPTIONAL`, which the schema checker
  ## reports.
  required with default: defaulted,
  type,
],

optional type: ONE OF [defaulted, type],

## An `OPTIONAL` field's type and the value it takes when left out:
## `OPTIONAL: INTEGER DEFAULT 50`. All-caps words side by side join into one
## call, so `INTEGER DEFAULT 50` is the call `INTEGER DEFAULT _`, and
## `LIST: TEXT DEFAULT []` is `LIST _` of `TEXT DEFAULT _`: the default
## still belongs to the whole field.
defaulted: ONE OF [
  text: ANYFIX CALL [WORD "TEXT", WORD "DEFAULT", default: ANY NODE],
  bytes: ANYFIX CALL [WORD "BYTES", WORD "DEFAULT", default: ANY NODE],
  integer: ANYFIX CALL [WORD "INTEGER", WORD "DEFAULT", default: ANY NODE],
  number: ANYFIX CALL [WORD "NUMBER", WORD "DEFAULT", default: ANY NODE],
  boolean: ANYFIX CALL [WORD "BOOLEAN", WORD "DEFAULT", default: ANY NODE],
  instant: ANYFIX CALL [WORD "INSTANT", WORD "DEFAULT", default: ANY NODE],
  duration: ANYFIX CALL [WORD "DURATION", WORD "DEFAULT", default: ANY NODE],
  list: ANYFIX CALL [WORD "LIST", item: defaulted],
  ## `LIST file summary DEFAULT []`
  list of named: ANYFIX CALL [WORD "LIST", item: type, WORD "DEFAULT", default: ANY NODE],
  map: ANYFIX CALL [WORD "MAP", value: defaulted],
  ## `MAP file summary DEFAULT {}`
  map of named: ANYFIX CALL [WORD "MAP", value: type, WORD "DEFAULT", default: ANY NODE],
  ## `page WITH (item: TEXT) DEFAULT { items [] }`
  generic: ANYFIX CALL [
    reference, WORD "WITH", arguments: type arguments,
    WORD "DEFAULT", default: ANY NODE,
  ],
  ## `shade DEFAULT dark`, or a type in parentheses, `(LIST: TEXT) DEFAULT []`
  other: ANYFIX CALL [type, WORD "DEFAULT", default: ANY NODE],
],

choice: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "CHOICE", body: choice body],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "CHOICE", body: choice body],
  public generic: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "PUBLIC", WORD "GENERIC", parameters: type parameters,
    WORD "CHOICE", body: choice body,
  ],
  generic: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "GENERIC", parameters: type parameters,
    WORD "CHOICE", body: choice body,
  ],
],

choice body: ANYFIX CALL [
  name: WORDS [NO KEYWORD],
  variants: CURLY BRACE [ONE OR MORE: variant],
],

## A named type gives a type its own name, `TYPE file id: TEXT`, so values
## that share a representation but mean different things can't be mixed up.
## On the wire it is written exactly like the type underneath.
named type: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "TYPE", body: named type body],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "TYPE", body: named type body],
],

named type body: ANYFIX CALL [name: WORDS [NO KEYWORD], type],

## A variant is written in the shape it takes on the wire. Its doc comes
## first, so it fills the call's first slot.
variant: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: variant slot],

variant slot: ONE OF [doc: STRING, parameter],

## A group of errors that methods share: its name and its own errors, then
## other groups joined with `+`, as in
## `ERRORS export errors [unreadable (diagnostics: LIST diagnostic)] + file errors`.
## `PUBLIC` lets other scopes use a type or a group, by its full path.
errors: ONE OF [
  public: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "PUBLIC", WORD "ERRORS", body: error list],
  private: ANYFIX CALL [doc: OPTIONAL: STRING, WORD "ERRORS", body: error list],
],

## A method's clauses come in this order, and `ERRORS` and `EXAMPLES` may be
## left out. The grammar language has no optional words, so each combination
## is a form of its own.
method: ONE OF [
  value with errors and examples: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", returns: returns,
    WORD "ERRORS", errors: error list,
    WORD "EXAMPLES", examples: examples,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "ERRORS", BREAK BEFORE WORD "EXAMPLES"],
  value with errors: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", returns: returns,
    WORD "ERRORS", errors: error list,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "ERRORS"],
  value with examples: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", returns: returns,
    WORD "EXAMPLES", examples: examples,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "EXAMPLES"],
  value: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", returns: returns,
  ] FORMAT [BREAK BEFORE WORD "RETURNS"],
  nothing with errors and examples: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", WORD "NOTHING",
    WORD "ERRORS", errors: error list,
    WORD "EXAMPLES", examples: examples,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "ERRORS", BREAK BEFORE WORD "EXAMPLES"],
  nothing with errors: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", WORD "NOTHING",
    WORD "ERRORS", errors: error list,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "ERRORS"],
  nothing with examples: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", WORD "NOTHING",
    WORD "EXAMPLES", examples: examples,
  ] FORMAT [BREAK BEFORE WORD "RETURNS", BREAK BEFORE WORD "EXAMPLES"],
  nothing: ANYFIX CALL [
    doc: OPTIONAL: STRING,
    WORD "METHOD", shape: shape,
    WORD "RETURNS", WORD "NOTHING",
  ] FORMAT [BREAK BEFORE WORD "RETURNS"],
],

## Examples of a method, each a call of it and its outcome, written as a line
## of a response writes them:
## `EXAMPLES [write "a" at revision 3 content "x" RETURNS 4]`. An empty list
## reads, so that the checker can say what is wrong with it.
examples: SQUARE BRACKET [ZERO OR MORE: example],

## The call is kept as a node for the schema checker to decode against the
## method. A `#` doc before an example lands inside its call, as the call's
## first argument, since `RETURNS` and `ERROR` split the run first; the
## checker reads it out of there.
example: ONE OF [
  returns nothing: ANYFIX CALL [call: ANY NODE, WORD "RETURNS", WORD "NOTHING"],
  returns: ANYFIX CALL [call: ANY NODE, WORD "RETURNS", value: ANY NODE],
  error: ANYFIX CALL [call: ANY NODE, WORD "ERROR", error: ANY NODE],
],

## A method that has nothing to return, such as `sign out`, says
## `RETURNS NOTHING`; a call of it that succeeds answers `RETURNS NOTHING`.

## What a method returns is named too: `RETURNS (new revision: INTEGER)`.
returns: parameter,

## A method's errors: its own in brackets, then groups joined with `+`:
## `[conflict at revision (revision: INTEGER)] + file errors`. Joined terms
## make one call, `_ + _`, and a group's full path, `files/file errors`,
## reads as `_/_` among them, so the schema checker reads the terms from the
## call's name: brackets, group names, and in a group's `ERRORS` its name
## before its own errors, the call `file errors _`.
error list: error term,

error term: ONE OF [
  own: SQUARE BRACKET [ONE OR MORE: error],
  call: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: error term],
],

## An error is written in its shape, like a variant, with its doc first.
error: variant,

shape: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: parameter],

parameter: ANYFIX CALL [name: WORDS [NO KEYWORD], type],

type: ONE OF [
  WORD "TEXT",
  WORD "BYTES",
  WORD "INTEGER",
  WORD "NUMBER",
  WORD "BOOLEAN",
  WORD "INSTANT",
  WORD "DURATION",
  list: ANYFIX CALL [WORD "LIST", item: type],
  ## Text keys, each to a value: `{ "hymn" 3, "ode" 1 }`.
  map: ANYFIX CALL [WORD "MAP", value: type],
  named: reference,
  ## A generic type with a type for each of its parameters, by name:
  ## `page WITH (item: file summary)`. `WITH` splits the run, so the
  ## arguments are one slot: one argument, `item: file summary`, is the call
  ## `item _`, and several are in parentheses.
  generic: ANYFIX CALL [reference, WORD "WITH", arguments: type arguments],
],

type arguments: ONE OF [several: PARENTHESIS [ONE OR MORE: parameter], one: parameter],

## A type by its name, `diagnostic`, or by its full path from
## another scope, `common/diagnostic`, which reads as the call `_/_` of
## `common` and `diagnostic`. The schema checker tells the two apart.
reference: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: type name],

type name: ANYFIX CALL [NAME [NO KEYWORD], NO ARGUMENTS],
