## Fixed wire syntax, independent of the methods and types in a schema.
## Calls and value calls keep their words and slots neutral: the checker
## decides which method, variant, or duration they mean.
ENTRY [ONE OR MORE: call],

call: ANYFIX CALL [ARGUMENTS: ZERO OR MORE: argument],
argument: ONE OF [
  annotated: ANYFIX CALL [value, WORD "AS", type],
  value,
],
value: ONE OF [
  duration,
  integer: NUMBER [WRITTEN INTEGER],
  float: NUMBER [WRITTEN FLOAT],
  text: STRING,
  list: SQUARE BRACKET [ZERO OR MORE: value],
  braces: CURLY BRACE [ZERO OR MORE: entry],
  call: value call,
],
## This is also a possible choice shape. The checker chooses the reading
## that fits its expected type; time.rs checks order, repeats and overflow.
duration: ANYFIX CALL [
  NAME [MATCHING REGEX "^(_ (days?|hours?|minutes?|seconds?|milliseconds?))( _ (days?|hours?|minutes?|seconds?|milliseconds?))*$"],
  ARGUMENTS: ONE OR MORE: count,
],
count: NUMBER [WRITTEN INTEGER],
value call: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: value],
## In braces, a map's entry is a key and a value. A record's entry is a
## value, and the checker reads from the record's fields which one it
## fills: `path "a"` is the call `path _`, `hidden` a checkbox,
## `changed more than (1 hour) ago` a field's shape, and `@by name` an `@`
## field's value.
entry: ONE OF [
  map: ANYFIX CALL [key: STRING, value],
  value,
],

## These rules are the schema language's type rules, including generic
## types. A snapshot test keeps them in step with protocol.anyx.
type: ONE OF [
  refined: ANYFIX CALL [base: type, WORD "WHERE", predicate: SQUARE BRACKET [ONE OR MORE: ANY NODE]],
  list: ANYFIX CALL [WORD "LIST", item: type],
  map: ANYFIX CALL [WORD "MAP", value: type],
  named: reference,
],
reference: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: type],
