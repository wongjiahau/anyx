## The schema language of the anyx protocol, in the grammar language.
## `src/grammar.rs` is generated from it; `tests/schema.rs` checks that it is
## up to date.

## A protocol entry starts with its header; a headerless file is a library.
## USE explicitly includes a file and exposes its PUBLIC declarations.
ENTRY [header: OPTIONAL: protocol, ZERO OR MORE: definition],

## Every doc is a `#` line string, `LINE STRING`: a quoted or raw string
## where a doc goes is an error.

## `INTRINSIC` before a `RECORD`, `CHOICE`, `TYPE` or `ERRORS` says that its
## shape is written here and the implementation supplies its meaning, as
## for the built-in types of `prelude.protocol.anyx`. The schema checker lets only
## the prelude use it.

protocol: ANYFIX CALL [
  doc: OPTIONAL: LINE STRING,
  WORD "PROTOCOL", name: type name,
  WORD "VERSION", version: NUMBER [INTEGER, AT LEAST 1, AT MOST 4294967295],
],

definition: ONE OF [record, choice, named type, errors, method, import],

import: ANYFIX CALL [WORD "USE", path: STRING],

record: ANYFIX CALL [
  doc: OPTIONAL: LINE STRING,
  intrinsic: OPTIONAL: WORD "INTRINSIC",
  public: OPTIONAL: WORD "PUBLIC",
  WORD "RECORD", body: record body,
],

## A record's name is a shape, then its fields in braces fill the last slot:
## `File Summary { path: Text }`. A generic record has a type parameter in
## each other slot, anywhere among the words: `Page of (item: Type) { … }`,
## `(item: Type) history { … }`. The schema checker reads the shape from the
## call's name, requires Title Case for a name with no type parameters,
## and checks that the braces come last.
record body: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: record part],

record part: ONE OF [fields: CURLY BRACE [ZERO OR MORE: field], type parameter],

## A type parameter of a generic `RECORD` or `CHOICE`, in a slot of its
## name: `(item: Type)`.
type parameter: ANYFIX CALL [name: WORDS [NO KEYWORD], marker: type marker],

type marker: ONE OF [WORD "Type"],

field: ANYFIX CALL [doc: OPTIONAL: LINE STRING, name: WORDS [NO KEYWORD], type: field type],

field type: ONE OF [defaulted, type],

## A field's type and the value it takes when left out.
defaulted: ONE OF [
  list: ANYFIX CALL [WORD "LIST", item: defaulted],
  ## `LIST File Summary DEFAULT []`
  list of named: ANYFIX CALL [WORD "LIST", item: type, WORD "DEFAULT", default: ANY NODE],
  map: ANYFIX CALL [WORD "MAP", value: defaulted],
  ## `MAP File Summary DEFAULT {}`
  map of named: ANYFIX CALL [WORD "MAP", value: type, WORD "DEFAULT", default: ANY NODE],
  ## `Integer DEFAULT 50`, `Shade DEFAULT dark`,
  ## `Page of (Text) DEFAULT { items [] }`, or a type in parentheses,
  ## `(LIST: Text) DEFAULT []`
  other: ANYFIX CALL [type, WORD "DEFAULT", default: ANY NODE],
],

choice: ANYFIX CALL [
  doc: OPTIONAL: LINE STRING,
  intrinsic: OPTIONAL: WORD "INTRINSIC",
  public: OPTIONAL: WORD "PUBLIC",
  WORD "CHOICE", body: choice body,
],

## A choice's name is a shape like a record's, with its variants in braces
## last: `(left: Type) or (right: Type) { first (value: left), … }`.
choice body: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: choice part],

choice part: ONE OF [variants: CURLY BRACE [ONE OR MORE: variant], type parameter],

## A named type gives a type its own name, `TYPE File Id: Text`, so values
## that share a representation but mean different things can't be mixed up.
## The checker requires a Title Case name. On the wire it is written
## exactly like the type underneath.
named type: ANYFIX CALL [
  doc: OPTIONAL: LINE STRING,
  intrinsic: OPTIONAL: WORD "INTRINSIC",
  public: OPTIONAL: WORD "PUBLIC",
  WORD "TYPE", body: named type body,
],

named type body: ONE OF [
  typed: ANYFIX CALL [name: WORDS [NO KEYWORD], type],
  ## A name alone, `INTRINSIC TYPE Integer`: the implementation supplies
  ## what it is. The schema checker reports one without `INTRINSIC`.
  bare: ANYFIX CALL [name: WORDS [NO KEYWORD]],
],

## A variant is written in the shape it takes on the wire. Its doc comes
## first, so it fills the call's first slot.
variant: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: variant slot],

variant slot: ONE OF [doc: LINE STRING, parameter, unnamed: ANYFIX CALL [name: WORDS [NO KEYWORD]]],

## A group of errors that methods share: its name and its own errors, then
## other groups joined with `+`, as in
## `ERRORS export errors [unreadable (diagnostics: LIST Diagnostic)] + file errors`.
## `PUBLIC` lets direct importers use a type or a group, by its plain name.
errors: ANYFIX CALL [
  doc: OPTIONAL: LINE STRING,
  intrinsic: OPTIONAL: WORD "INTRINSIC",
  public: OPTIONAL: WORD "PUBLIC",
  WORD "ERRORS", body: error list,
],

## A method's clauses come in this order. It returns a value or `NOTHING`,
## and the rest may be left out. `READ ONLY` and `IDEMPOTENT` claim it is
## safe to call freely, or to retry; without them it may change anything,
## once per call. Both together are read, so that the schema checker can say
## that `READ ONLY` already means `IDEMPOTENT`.
method: ANYFIX CALL [
  doc: OPTIONAL: LINE STRING,
  read only: OPTIONAL: WORDS "READ ONLY",
  idempotent: OPTIONAL: WORD "IDEMPOTENT",
  WORD "METHOD", shape: shape,
  requires: OPTIONAL [WORD "REQUIRES", condition],
  WORD "RETURNS", returns: ONE OF [value: returns, nothing: WORD "NOTHING"],
  ensures: OPTIONAL [WORD "ENSURES", condition],
  errors: OPTIONAL [WORD "ERRORS", error list],
  undone by: OPTIONAL [WORD "UNDONE", WORD "BY", undo],
  examples: OPTIONAL [WORD "EXAMPLES", examples],
] FORMAT [
  BREAK BEFORE WORD "REQUIRES",
  BREAK BEFORE WORD "RETURNS",
  BREAK BEFORE WORD "ENSURES",
  BREAK BEFORE WORD "ERRORS",
  BREAK BEFORE WORD "UNDONE",
  BREAK BEFORE WORD "EXAMPLES",
],

condition: SQUARE BRACKET [predicate: ONE OR MORE: ANY NODE],

## The call that undoes a method, written like a shape whose slots are the
## method's own parameters: `UNDONE BY move (new path: Text) to (path: Text)`.
## The types say which method it is, among methods of the same words.
undo: shape,

## Examples of a method, each a call of it and its outcome side by side, the
## call as a request writes it and the outcome as a response writes it:
## `EXAMPLES [write "a" at revision 3 content "x" RETURNS 4]`. An empty list
## reads, so that the checker can say what is wrong with it.
examples: SQUARE BRACKET [ZERO OR MORE: example],

## The call is kept as a node for the schema checker to decode against the
## method. A `#` doc before an example lands inside its call, as the call's
## first argument, since `RETURNS` and `ERROR` split the run first; the
## checker reads it out of there.
example: ONE OF [
  returns nothing: ANYFIX CALL [call: ANY NODE, WORD "RETURNS", WORD "NOTHING"],
  returns: ANYFIX CALL [call: ANY NODE, WORD "RETURNS", value: ANY NODE],
  error: ANYFIX CALL [call: ANY NODE, WORD "ERROR", error: ANY NODE],
],

## A method that has nothing to return, such as `sign out`, says
## `RETURNS NOTHING`; a call of it that succeeds answers `RETURNS NOTHING`.

## What a method returns is named too: `RETURNS (new revision: Integer)`.
returns: parameter,

## A method's errors: its own in brackets, then groups joined with `+`:
## `[conflict at revision (revision: Integer)] + file errors`. Joined terms
## make one call, `_ + _`, so the checker reads the plain group names
## from its arguments. A group's own errors follow its name.
error list: error term,

error term: ONE OF [
  own: SQUARE BRACKET [ONE OR MORE: error],
  call: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: error term],
],

## An error is written in its shape, like a variant, with its doc first.
error: variant,

shape: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: parameter],

parameter: ANYFIX CALL [name: WORDS [NO KEYWORD], type],

## A built-in type such as `Integer` is no keyword: the prelude declares
## it, so it reads as a `reference` like any other type.
type: ONE OF [
  refined: ANYFIX CALL [base: type, WORD "WHERE", predicate: SQUARE BRACKET [ONE OR MORE: ANY NODE]],
  list: ANYFIX CALL [WORD "LIST", item: type],
  ## Text keys, each to a value: `{ "hymn" 3, "ode" 1 }`.
  map: ANYFIX CALL [WORD "MAP", value: type],
  named: reference,
],

## A type by its name, `Diagnostic`, or a generic one by its shape with a
## type in each slot, in parentheses: `Page of (File)`, `(Integer) or
## (Text)`. Names are always unqualified; the checker rejects legacy paths.
reference: ANYFIX CALL [NAME [NO KEYWORD], ARGUMENTS: ZERO OR MORE: type],

type name: ANYFIX CALL [NAME [NO KEYWORD], NO ARGUMENTS],
